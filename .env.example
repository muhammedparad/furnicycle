# Copy to .env.local and fill in. With the two Supabase values empty, the site runs in
# demo mode: accounts, listings and photos are kept in the visitor's browser only.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: photo recognition for "Price it with AI". Without it, prices are estimated
# from category, condition, age and similar listings.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
